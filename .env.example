API_KEY=
LLM_TIMEOUT_SECONDS=90
LLM_OFFLINE=0
CHEAP_MODEL=
DEFAULT_MODEL=
SMART_MODEL=

# Leave API_KEY empty to run offline demo mode.
# Fill it with a valid DashScope / OpenAI-compatible API key to use the real LLM.
# Set LLM_OFFLINE=1 when you want local smoke tests without spending API tokens.
# Optional model tiers:
# CHEAP_MODEL handles low-risk JSON repair.
# DEFAULT_MODEL handles batch extraction and regression.
# SMART_MODEL handles attribution and evolution generation.
